{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "APP_ADMIN_USERNAME": {
          "type": "string"
        },
        "LOG_LEVEL": {
          "type": "string"
        },
        "GOMAXPROCS": {
          "type": "string"
        },
        "META_DB_MAX_CONNS": {
          "type": "string"
        },
        "DBHUB_TARGET_ALLOWLIST": {
          "type": "string",
          "minLength": 1
        },
        "DBHUB_TRUSTED_PROXY_CIDRS": {
          "type": "string"
        },
        "CORS_ALLOWED_ORIGINS": {
          "type": "string"
        },
        "DBHUB_AUDIT_MAX_PENDING": {
          "type": "string"
        },
        "DBHUB_AUDIT_RETENTION_DAYS": {
          "type": "string"
        },
        "DBHUB_HISTORY_RETENTION_DAYS": {
          "type": "string"
        },
        "DBHUB_READ_NOTIFICATION_RETENTION_DAYS": {
          "type": "string"
        },
        "DBHUB_BACKUP_EXPECTED_HOURS": {
          "type": "string"
        },
        "DBHUB_LOGIN_MAX_ATTEMPTS": {
          "type": "string"
        },
        "DBHUB_LOGIN_IP_MAX_ATTEMPTS": {
          "type": "string"
        },
        "DBHUB_LOGIN_WINDOW_SECONDS": {
          "type": "string"
        }
      },
      "required": [
        "DBHUB_TARGET_ALLOWLIST"
      ]
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "jdbc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 7200
        },
        "resources": {
          "type": "object"
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "existingClaim": {
          "type": "string"
        }
      }
    }
