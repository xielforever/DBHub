# 将这些项合并到被忽略的根.env.local，不覆盖其他配置。
# 地址与凭据均为本机配置；密码需URL编码。禁止提交真实连接串。
DBHUB_METADATA_URL=postgres://USER:URL_ENCODED_PASSWORD@CERTIFICATE_HOSTNAME:PORT/DATABASE?sslmode=verify-full&sslrootcert=/run/dbhub-infra/ca.crt
DBHUB_REDIS_URL=redis://TAILSCALE_HOST:PORT/DEDICATED_DB_NUMBER
DBHUB_MIGRATION_TIMEOUT_SECONDS=180
DBHUB_READINESS_TIMEOUT_SECONDS=10
DBHUB_REDIS_PROBE_TIMEOUT_MS=3000
DBHUB_LOGIN_REDIS_TIMEOUT_MS=3000
DBHUB_CONNECTION_CHECK_PERSIST_TIMEOUT_SECONDS=15
VITE_CONNECTION_TEST_TIMEOUT_MS=90000
VITE_DATABASE_LIST_TIMEOUT_MS=90000
VITE_IAM_EFFECTIVE_TIMEOUT_MS=45000
DBHUB_INFRA_HOSTNAME=CERTIFICATE_HOSTNAME
DBHUB_INFRA_ADDRESS=TAILSCALE_ADDRESS
DBHUB_INFRA_CA_FILE=/absolute/wsl/path/to/verified-public-ca.crt
# 多个已获准数据源以逗号分隔，保留原有需要访问的目标。
DBHUB_TARGET_ALLOWLIST=TAILSCALE_HOST:PORT
