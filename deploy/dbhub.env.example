# Copy to a private 0600 file. Never commit real values.
# Values are literal KEY=value, without shell substitutions or surrounding quotes.
APP_ENV=production
# At least 32 random bytes; empty values deliberately prevent startup.
APP_SECRET_KEY=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# e.g. postgres://USER:URL_ENCODED_PASSWORD@HOST:5432/dbhub?sslmode=verify-full
DATABASE_URL=
# e.g. rediss://:URL_ENCODED_PASSWORD@HOST:6379/0
REDIS_URL=
DBHUB_TARGET_ALLOWLIST=inventory.example:5432
META_DB_MAX_CONNS=10
DBHUB_LOGIN_MAX_ATTEMPTS=10
DBHUB_LOGIN_IP_MAX_ATTEMPTS=60
DBHUB_LOGIN_WINDOW_SECONDS=300
DBHUB_TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=
DBHUB_AUDIT_MAX_PENDING=10000
DBHUB_AUDIT_RETENTION_DAYS=0
DBHUB_HISTORY_RETENTION_DAYS=0
DBHUB_READ_NOTIFICATION_RETENTION_DAYS=90
DBHUB_BACKUP_EXPECTED_HOURS=0
# Enable JDBC only when its service and shared token are configured.
DBHUB_JDBC_URL=
DBHUB_JDBC_TOKEN=
# Compose/Docker require explicit locally built or published image references.
DBHUB_BACKEND_IMAGE=
DBHUB_FRONTEND_IMAGE=
DBHUB_JDBC_IMAGE=
DBHUB_BACKUP_IMAGE=
