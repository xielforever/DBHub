# DBHub 前端生产镜像（kaniko 兼容版，供 SunMao 流水线使用）。
# 与 frontend/Dockerfile 产物一致；不使用 BuildKit 的 RUN --mount 语法。
ARG IMAGE_VERSION=swr.cn-east-2.myhuaweicloud.com/dx_x2era/node:24.12.0-bullseye-slim
FROM ${IMAGE_VERSION} AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --strict-ssl=true --no-audit --no-fund
COPY . .
RUN npm run build

FROM swr.cn-east-2.myhuaweicloud.com/dx_x2era/nginx:1.30.6-alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/dbhub-security-headers.conf
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 CMD wget -Y off -q -O /dev/null http://127.0.0.1/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
