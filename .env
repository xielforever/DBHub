# ========== DBHub 开发环境配置 ==========
# 注意：本文件仅为本地开发样例，可安全提交；生产环境请通过密钥管理系统注入。

# ---------- 镜像版本 ----------
FRONTEND_IMAGE_VERSION=node:24.12.0-bullseye
BACKEND_IMAGE_VERSION=golang:1.25.5-alpine3.23
POSTGRES_IMAGE_VERSION=postgres:16-alpine
REDIS_IMAGE_VERSION=redis:7-alpine

# ---------- 开发端口 ----------
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- 通用配置 ----------
APP_ENV=development
LOG_LEVEL=debug

# ---------- 安全配置 ----------
# JWT/敏感字段加密主密钥（生产环境必须通过环境变量注入，长度 >= 32 字节）
APP_SECRET_KEY=dev-only-dbhub-secret-key-please-change-32b
# 开发期引导管理员账号（首次启动写入内存/元数据库，生产环境请禁用）
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
# Access Token 有效期（分钟）/ Refresh Token 有效期（小时）
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ---------- PostgreSQL 元数据库 ----------
POSTGRES_USER=dbhub
POSTGRES_PASSWORD=dbhub_dev_password
POSTGRES_DB=dbhub_meta

# ---------- Redis 缓存 ----------
REDIS_PASSWORD=
