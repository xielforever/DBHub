  "findings": [
    {
      "id": "S01",
      "priority": "P1",
      "problem": "正式报表通过普通草稿送审，可绕过专用受众变更的新增受益人检查",
      "remediation": "验证、验证记录入库、审批及首次发布均检查审阅人是否新增受益；下线后仍比较最近发布的受众。覆盖直接授权与组成员变化，保留独立审批和历史恢复正向用例",
      "status": "fixed"
    },
    {
      "id": "S02",
      "priority": "P1",
      "problem": "管理员可审批自己提交的变更工单",
      "remediation": "仓储原子更新要求当前管理员、真实操作者及申请人不同；并发决定只有一次成功；执行仍需已批准状态",
      "status": "fixed"
    },
    {
      "id": "S03",
      "priority": "P2",
      "problem": "管理员可批准自己的导出申请",
      "remediation": "独立管理员审批，禁止覆盖已决定状态；下载仍限申请人及其当前连接授权。历史自批的导出恢复待审",
      "status": "fixed"
    },
    {
      "id": "S04",
      "priority": "P1",
      "problem": "工单只保存可修改的个人连接 ID，批准后可更换目标修订再执行",
      "remediation": "提交时冻结目标修订与数据库；审批、领取执行及发 SQL 前校验；执行者使用自己的同修订凭据，禁止借用申请人凭据",
      "status": "fixed"
    },
    {
      "id": "S05",
      "priority": "P1",
      "problem": "Redis 建立会话后撤销数据源权限，仍可派发删除命令",
      "remediation": "在每次读取、扫描、概览及修改命令前重查当前成员、源授权、配置与驱动；真实 Redis 撤权用例确认原键保留",
      "status": "fixed"
    },
    {
      "id": "S06",
      "priority": "P1",
      "problem": "管理员请求暂停期间被撤权并恢复后，维护连接可继续重置其他人的密码",
      "remediation": "维护事务锁定并核对捕获的成员版本；旧请求失败，新请求按当前授权正常执行",
      "status": "fixed"
    },
    {
      "id": "S07",
      "priority": "P1",
      "problem": "Cookie 兜底认证的修改请求缺少 CSRF 防护",
      "remediation": "Cookie 修改请求必须带 `X-DBHub-CSRF: 1`，前端自动携带；跨源浏览器必须通过生产 CORS 白名单预检；普通 Bearer API 调用不增加要求",
      "status": "fixed"
    },
    {
      "id": "S08",
      "priority": "P1",
      "problem": "SSH 连通性测试绕过平台目标白名单",
      "remediation": "测试在拨号前执行相同目标校验；本地 TCP 监听用例证明白名单外地址没有收到连接",
      "status": "fixed"
    },
    {
      "id": "S09",
      "priority": "P1",
      "problem": "删除隧道/代理会静默转为直连；删除发布者连接会级联清除查询策略，使他人结果范围扩大",
      "remediation": "网络引用外键改为 `RESTRICT`；承载策略的连接在删除或切换目标修订前锁定父记录并检查依赖，覆盖并发创建策略，返回 409；显式处理策略后可操作。真实复现确认删除前只读账号返回 1 行，原删除路径会扩大到 2 行",
      "status": "fixed"
    },
    {
      "id": "S10",
      "priority": "P2",
      "problem": "管理员可以删除他人的个人查询历史，清空路径还尝试截断共享表",
      "remediation": "单条删除及清空始终限当前用户，工作空间 RLS 继续生效；清空自己不影响其他人的记录",
      "status": "fixed"
    },
    {
      "id": "S11",
      "priority": "P2",
      "problem": "已停用的旧分享接口仍允许查询或撤销其他人的记录",
      "remediation": "列表、撤销与删除均限制创建者；无权或不存在统一 404；公开读取及新建公开分享保持停用",
      "status": "fixed"
    },
    {
      "id": "S12",
      "priority": "P1",
      "problem": "报表下线后，可自行加入其历史受众组，再恢复发布取得数据权限",
      "remediation": "用户组防自授权检查包含历史发布；已有组的版本与成员检查在同一行锁内，发布与组变更串行校验",
      "status": "fixed"
    },
    {
      "id": "S13",
      "priority": "P3",
      "problem": "旧仪表盘收藏可修改不可见的私有对象，仓储修改与删除缺少归属条件",
      "remediation": "收藏要求当前可见且只修改本人的收藏；仓储修改、删除也校验归属，管理员仅可维护可见的工作空间共享旧定义",
      "status": "fixed"
    },
    {
      "id": "S14",
      "priority": "P2",
      "problem": "概览排行的自定义提示将连接名直接作为 HTML，恶意标签可插入 DOM",
      "remediation": "此提示改为 Canvas 富文本绘制，连接名不进入 HTML 解释；真实生产浏览器验证恶意 `img` 标签不再生成元素。此处复现的是 HTML 注入，未将其夸大为已绕过生产 CSP 执行脚本",
      "status": "fixed"
    }
  ],
